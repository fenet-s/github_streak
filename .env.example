# ─── Application ───────────────────────────────────────
SERVER_PORT=8080
APP_ENV=development

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/streak_guardian?sslmode=disable

# ─── GitHub OAuth ──────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback

# ─── Telegram ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Security ──────────────────────────────────────────
# Used to sign OAuth state tokens (min 32 chars, random string)
JWT_SECRET=change_this_to_a_random_32_char_secret_string

# ─── Token Encryption ──────────────────────────────────
# AES-256 key for encrypting GitHub access tokens at rest (must be exactly 32 chars)
ENCRYPTION_KEY=change_this_to_a_random_32_char_key_
